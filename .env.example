# Crawler identity and scheduler protection
CRAWLER_CONTACT_EMAIL=you@example.com
CRON_SECRET=replace-with-a-long-random-value

# Admin console authentication. Store only a scrypt hash, never the plaintext password.
ADMIN_USERNAME=
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Crawler resilience and distributed run lease
CRAWLER_TIMEOUT_MS=12000
CRAWLER_FETCH_RETRIES=2
CRAWLER_RETRY_BASE_MS=400
CRAWL_CONCURRENCY=4
CRAWL_LEASE_TTL_MS=480000
CRAWL_INTERVAL_MINUTES=60
ENABLE_LOCAL_SCHEDULER=0
# Keep disabled in production so anonymous page/API reads never start a crawl.
ENABLE_REQUEST_CRAWL=0
USE_CLOUD_STORE=0

# /api/health marks a completed crawl stale after this many minutes
HEALTH_MAX_CRAWL_AGE_MINUTES=150

# Upstash Redis for mutable production crawl state (preferred)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Private Vercel Blob fallback
BLOB_READ_WRITE_TOKEN=

# Comma-separated search terms for marketplace APIs
CRAWL_KEYWORDS=생수,휴지,커피,SSD,모니터,운동화,선크림,로션,마스크팩,향수

# Naver Shopping Search API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
NAVER_SHOPPING_QUERIES=생수,휴지,커피,SSD,모니터,운동화,선크림,로션,마스크팩,향수
NAVER_PROMOTION_FEED_URL=
NAVER_PROMOTION_FEED_TOKEN=

# Coupang Partners Open API
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SUB_ID=
COUPANG_AFFILIATE_LINK_TIMEOUT_MS=2500
COUPANG_AFFILIATE_CACHE_TTL_MS=604800000

# 11st Open API (product search)
ELEVENST_API_KEY=
ELEVENST_QUERIES=생수,휴지,커피,SSD,모니터,운동화,선크림,로션,마스크팩,향수

# Gmarket approved affiliate/data feed. Must return the documented JSON shape.
GMARKET_FEED_URL=
GMARKET_FEED_TOKEN=

# Auction approved affiliate/data feed
AUCTION_FEED_URL=
AUCTION_FEED_TOKEN=

# Approved community/commerce feeds for sources that block generic crawlers
QUASARZONE_FEED_URL=
QUASARZONE_FEED_TOKEN=
SSG_FEED_URL=
SSG_FEED_TOKEN=
OLIVEYOUNG_FEED_URL=
OLIVEYOUNG_FEED_TOKEN=

# Optional affiliate attribution. Configure only keys/templates issued by each approved partner.
# QUERY_VALUE falls back to ID. Existing destination query parameters and hashes are preserved.
AFFILIATE_11ST_ID=
AFFILIATE_11ST_QUERY_KEY=
AFFILIATE_11ST_QUERY_VALUE=
AFFILIATE_11ST_TEMPLATE=
AFFILIATE_GMARKET_ID=
AFFILIATE_GMARKET_QUERY_KEY=
AFFILIATE_GMARKET_QUERY_VALUE=
AFFILIATE_GMARKET_TEMPLATE=
AFFILIATE_AUCTION_ID=
AFFILIATE_AUCTION_QUERY_KEY=
AFFILIATE_AUCTION_QUERY_VALUE=
AFFILIATE_AUCTION_TEMPLATE=
AFFILIATE_NAVER_ID=
AFFILIATE_NAVER_QUERY_KEY=
AFFILIATE_NAVER_QUERY_VALUE=
AFFILIATE_NAVER_TEMPLATE=
AFFILIATE_SSG_ID=
AFFILIATE_SSG_QUERY_KEY=
AFFILIATE_SSG_QUERY_VALUE=
AFFILIATE_SSG_TEMPLATE=
AFFILIATE_OLIVEYOUNG_ID=
AFFILIATE_OLIVEYOUNG_QUERY_KEY=
AFFILIATE_OLIVEYOUNG_QUERY_VALUE=
AFFILIATE_OLIVEYOUNG_TEMPLATE=
