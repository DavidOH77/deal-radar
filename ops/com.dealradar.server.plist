<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dealradar.server</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-s</string>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/ohyeseong/Library/Application Support/DealRadar/runtime/server.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/ohyeseong/Library/Application Support/DealRadar/runtime</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>PORT</key>
    <string>3000</string>
    <key>ENABLE_LOCAL_SCHEDULER</key>
    <string>1</string>
    <key>USE_CLOUD_STORE</key>
    <string>1</string>
    <key>NODE_DISABLE_COMPILE_CACHE</key>
    <string>1</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>/Users/ohyeseong/Library/Logs/deal-radar.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ohyeseong/Library/Logs/deal-radar.error.log</string>
</dict>
</plist>
